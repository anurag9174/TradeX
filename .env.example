# TradeX environment template.
#
# Copy to .env and adjust. The backend reads these as Spring property overrides;
# the docker-compose stack reads the MYSQL_* values.
#
#   cp .env.example .env
#
# NOTHING here is required for the default simulated setup: docker compose up -d
# plus `mvn spring-boot:run` works out of the box with the defaults in
# backend/src/main/resources/application.yml.

# ---------------------------------------------------------------------------
# Database (docker-compose.yml)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=tradex-root
MYSQL_DATABASE=tradex
MYSQL_USER=tradex
MYSQL_PASSWORD=tradex

# Used when running the backend outside Docker against the compose MySQL.
TRADEX_DB_URL=jdbc:mysql://localhost:3307/tradex?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&rewriteBatchedStatements=true
TRADEX_DB_USERNAME=tradex
TRADEX_DB_PASSWORD=tradex

# ---------------------------------------------------------------------------
# Security - REQUIRED to change before any non-local deployment
# ---------------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 48
TRADEX_SECURITY_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
TRADEX_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development convenience: create a demo user on startup (demo / demo12345).
TRADEX_SEED_DEMO_USER=false
TRADEX_DEMO_USERNAME=demo
TRADEX_DEMO_PASSWORD=demo12345
TRADEX_DEMO_EMAIL=demo@tradex.local

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# auto      -> live provider when the selected provider is configured, otherwise SIMULATED (default)
# simulated -> always the generated feed, clearly labelled
# live      -> require the selected provider; the app refuses to start without one
TRADEX_MARKETDATA_MODE=auto

# twelvedata -> equities/crypto via Twelve Data (https://twelvedata.com); needs the key below
# delta      -> Delta Exchange India crypto derivatives, public market data (NO key needed).
#               Quotes USD perpetuals (BTCUSD, ETHUSD); it has no NSE/BSE coverage - in live mode
#               those instruments show an honest "live price unavailable" state, never a fake price.
TRADEX_MARKETDATA_PROVIDER=twelvedata

# Twelve Data API key. Only used by the twelvedata provider.
TRADEX_MARKETDATA_API_KEY=

# Delta Exchange public API base (demo/testnet: https://cdn-ind.testnet.deltaex.org)
TRADEX_DELTA_BASE_URL=https://api.india.delta.exchange

# Legacy INR-account valuation rate for historical USD positions only. It is not a live FX feed,
# and it does not enable cross-currency orders for new USD accounts.
TRADEX_FX_USD_INR=88.50

# ---------------------------------------------------------------------------
# Trading behaviour
# ---------------------------------------------------------------------------
TRADEX_INITIAL_BALANCE=10000.00
TRADEX_MINIMUM_INITIAL_BALANCE=100.00
TRADEX_MAXIMUM_INITIAL_BALANCE=1000000.00
TRADEX_DEFAULT_ACCOUNT_CURRENCY=USD
TRADEX_TRADING_ZONE=Asia/Kolkata
TRADEX_SLIPPAGE_BPS=0
TRADEX_MATCHING_ENABLED=true
